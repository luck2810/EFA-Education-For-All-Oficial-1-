rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return autenticado()
        && (
          (request.auth.token.email != null && request.auth.token.email.toLowerCase() == 'administrador.efa@gmail.com')
          || request.auth.uid == 'N30w5z3U2mXPQjpIbsp9jwTq96q1'
        );
    }

    function ehDono(userId) {
      return autenticado() && request.auth.uid == userId;
    }

    match /usuarios/{userId} {
      allow read: if ehDono(userId) || ehAdmin();

      allow create: if ehDono(userId)
        && request.resource.data.moedas == 0
        && request.resource.data.premium == false;

      allow update: if ehAdmin()
        || (
          ehDono(userId)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['moedas'])
          && resource.data.moedas >= 1
          && request.resource.data.moedas == resource.data.moedas - 1
        )
        || (
          ehDono(userId)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['nome', 'email'])
        );

      allow delete: if ehAdmin();
    }

    // Solicitações de Premium: o usuário só cria e lê as próprias.
    // Aprovação, recusa e alteração do Premium ficam restritas ao administrador.
    match /solicitacoes_pagamento/{solicitacaoId} {
      allow read: if ehAdmin()
        || (
          autenticado()
          && resource.data.userId == request.auth.uid
        );

      allow create: if autenticado()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.plano == 'premium_30_dias'
        && request.resource.data.valor == 5;

      allow update, delete: if ehAdmin();
    }

    match /aulas/{aulaId} {
      allow read: if resource.data.status == 'aprovada'
        || (
          autenticado()
          && resource.data.autorId == request.auth.uid
        )
        || ehAdmin();

      allow create: if autenticado()
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.status == 'pendente';

      allow update, delete: if ehAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow create, update, delete: if ehAdmin();
    }

    match /deficiencias/{deficienciaId} {
      allow read: if true;
      allow create, update, delete: if ehAdmin();
    }

    match /materias/{materiaId} {
      allow read: if true;
      allow create, update, delete: if ehAdmin();
    }

    match /transacoes/{transacaoId} {
      allow read: if ehAdmin()
        || (
          autenticado()
          && resource.data.usuarioId == request.auth.uid
        );

      allow create: if ehAdmin()
        || (
          autenticado()
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.tipo == 'gasto'
          && request.resource.data.quantidade == 1
        );

      allow update, delete: if ehAdmin();
    }

    match /aulasDesbloqueadas/{desbloqueioId} {
      allow read: if ehAdmin()
        || (
          autenticado()
          && resource.data.usuarioId == request.auth.uid
        );

      allow create: if autenticado()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.aulaId is string
        && request.resource.data.aulaId != '';

      allow update, delete: if ehAdmin();
    }

    match /denuncias/{denunciaId} {
      allow create: if autenticado()
        && request.resource.data.denunciadorId == request.auth.uid
        && request.resource.data.status == 'pendente';

      allow read: if ehAdmin()
        || (
          autenticado()
          && resource.data.denunciadorId == request.auth.uid
        );

      allow update, delete: if ehAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
